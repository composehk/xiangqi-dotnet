<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Web SDK adds the <aspNetCore> handler on publish; this file only hardens IIS response headers. -->
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
